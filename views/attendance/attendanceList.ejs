<%- include('../partials/header') %>

<div class="container mt-5">

    <h2>Attendance Records</h2>

    <table class="table table-bordered">

        <tr>
            <th>ID</th>
            <th>Employee</th>
            <th>Date</th>
            <th>Status</th>
        </tr>

        <% attendance.forEach(record => { %>

            <tr>
                <td><%= record.id %></td>
                <td><%= record.name %></td>
                <td><%= record.date %></td>
                <td><%= record.status %></td>
            </tr>

        <% }) %>

    </table>

</div>

<%- include('../partials/footer') %>