<%- include('../partials/header') %>

<div class="container mt-5">

    <div class="d-flex justify-content-between">

        <h2>
            Welcome <%= admin.name %>
        </h2>

        <a href="/logout" class="btn btn-danger">
            Logout
        </a>

    </div>

    <hr>

    <div class="row mt-4">

        <div class="col-md-3">

            <div class="card text-center shadow">

                <div class="card-body">

                    <h5>Total Employees</h5>

                    <h2>
                        <%= totalEmployees %>
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card text-center shadow">

                <div class="card-body">

                    <h5>Present Today</h5>

                    <h2>
                        <%= presentToday %>
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card text-center shadow">

                <div class="card-body">

                    <h5>Absent Today</h5>

                    <h2>
                        <%= absentToday %>
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card text-center shadow">

                <div class="card-body">

                    <h5>Leave Count</h5>

                    <h2>
                        <%= leaveCount %>
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <div class="mt-5">

        <a href="/employees" class="btn btn-primary">
            Manage Employees
        </a>

        <a href="/attendance" class="btn btn-success">
            Attendance
        </a>

        <a href="/attendanceList" class="btn btn-dark">
            Attendance Records
        </a>

    </div>

</div>

<%- include('../partials/footer') %>